# Bubble 环境变量模板
# 复制为 .env 后按需修改

# ============================================
# Docker Compose
# ============================================
COMPOSE_PROJECT_NAME=bubble

# ============================================
# 应用
# ============================================
APP_NAME=Bubble
ENV=development
DEBUG=true

# ============================================
# 数据库 - PostgreSQL
# ============================================
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=bubble
POSTGRES_PASSWORD=bubble123
POSTGRES_DB=bubble

# ============================================
# Neo4j
# ============================================
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=bubbleneo4j

# ============================================
# Redis
# ============================================
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# ============================================
# 安全 - 一条命令生成并写入 .env:python api/gen_keys.py --write
# 脚本只用标准库,任意 Python 3 都能跑;没装 Python 用 uv 代跑:
#   uv run --no-project python api/gen_keys.py --write
# 或手动生成(不依赖任何第三方包):
# JWT_SECRET  = python -c "import secrets; print(secrets.token_urlsafe(32))"
# FERNET_KEY  = python -c "import base64,secrets; print(base64.urlsafe_b64encode(secrets.token_bytes(32)).decode())"
# ============================================
JWT_SECRET=
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440
FERNET_KEY=

# ============================================
# CORS
# ============================================
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]

# ============================================
# 国内网络:Docker Hub 拉不动时可换成镜像源(web 镜像构建用)
# ============================================
# NODE_IMAGE=docker.m.daocloud.io/library/node:20-alpine
# NGINX_IMAGE=docker.m.daocloud.io/library/nginx:alpine
# ghcr.io 拉不动时(api 镜像构建用),可换成可用的镜像源
# UV_IMAGE=ghcr.nju.edu.cn/astral-sh/uv:python3.13-bookworm-slim

# ============================================
# 后台任务(兴趣抽取/情绪分析/摘要/洞察)
# ============================================
# inline = 进程内 asyncio(本地开发,不需要 worker);celery = 进 Redis 队列(进程重启不丢)
# Docker 部署由 compose 自动设为 celery,并启动 worker / beat 两个服务
BACKGROUND_MODE=inline

# 兴趣抽取批处理:攒够 N 条 或 静默 M 秒触发一次(设 N=1 关闭批处理,逐条抽取)
INTEREST_BATCH_SIZE=5
INTEREST_BATCH_WAIT_SECONDS=60
